# Backend API URL (required for production)
# In development, Vite proxy handles API calls automatically
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Firebase Cloud Messaging (web push) - OPTIONAL.
# Push notifications stay disabled until ALL of these are set.
# Values come from Firebase Console -> Project Settings -> your Web App config,
# and the VAPID key from Cloud Messaging -> Web Push certificates.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
